# ---------------------------------------------------------------------------
# HelpDeskPro API - variables d'environnement
# Copier ce fichier en `.env` et adapter les valeurs.
#   cp .env.example .env
# ---------------------------------------------------------------------------

NODE_ENV=development

# Port d'écoute de l'API
PORT=5000

# Base de données principale (créée par `npm run db:create`)
DATABASE_URL=postgresql://postgres:Helpdesk2026!@localhost:5432/helpdeskpro

# Base de données dédiée aux tests (créée par `npm run db:create`)
TEST_DATABASE_URL=postgresql://postgres:Helpdesk2026!@localhost:5432/helpdeskpro_test

# Secret de signature JWT. Minimum 32 caractères en production.
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=8h

# Coût bcrypt (10-12 en développement, 12+ en production)
BCRYPT_ROUNDS=12

# Origines autorisées pour le CORS, séparées par des virgules
CORS_ORIGIN=http://localhost:5173

# Niveau de log : error | warn | info | debug
LOG_LEVEL=info
